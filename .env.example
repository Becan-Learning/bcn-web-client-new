# عنوان خادم بيكان؛ تُمرَّر إليه طلبات المصادقة والكتالوج والتسجيل ورمز الجلسة من نفس أصل الويب.
BACKEND_URL="http://localhost:3000"

# بيانات الوصول إلى محتوى المقرر وشرائحه.
BUNNY_STORAGE_API_KEY =""
BUNNY_STORAGE_PULL_ZONE_URL=""

# بيانات الوصول إلى سجلات الجلسة وتقييمها.
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# صفحة تجربة المعلّم الجديد (/demo): تُغلق في الإنتاج ما لم تُضبط على 1.
# لا تحتاج الصفحة إلى مفاتيح: الرمز وعنوان LiveKit يأتيان من الرابط الذي يطبعه
# أمر الرمز في مستودع الوكيل (bcn-lk-agent-new). مفاتيح LiveKit وElevenLabs
# (ومعرّف الصوت ELEVEN_VOICE_ID) وOpenAI تعيش في .env.example هناك.
NEXT_PUBLIC_DEMO=""

# حدود الحصة عند تعذّر قراءة الباقة من قاعدة البيانات.
QUOTA_DEFAULT_DAILY_MINUTES=60
QUOTA_DEFAULT_DAILY_SESSIONS=5

NODE_ENV="development"
